<view class="container">
  <view class="hero card">
    <view class="brand">OpenAA</view>
    <view class="hero-title">美国华人生活平台</view>
    <view class="hero-sub">找工作 · 找房子 · 华人生活</view>
  </view>
  <view class="card">
    <view class="section-title">生活分类</view>
    <view class="grid">
      <view class="entry" wx:for="{{quickLinks}}" wx:key="key" data-key="{{item.key}}" data-type="{{item.type}}" bindtap="openShortcut">
        <view class="emoji">{{item.emoji}}</view><view>{{item.label}}</view>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="section-title">在美国生活 · 从 OpenAA 开始</view>
    <view class="muted">浏览新闻、招聘、房屋、二手及本地服务。小程序仅供查看，信息与 OpenAA.com 主站同步。</view>
  </view>
  <view class="card">
    <view class="section-title">需要发布信息？</view>
    <view class="muted">发布、编辑或管理信息请前往 OpenAA.com 网页版。</view>
    <button type="primary" style="margin-top:20rpx" bindtap="promptWebPublish">前往网页版发布</button>
  </view>
  <view class="card">
    <view class="row"><view class="section-title">最新招聘</view><view class="muted" data-key="jobs" bindtap="openChannel">更多 ›</view></view>
    <view wx:if="{{loading}}" class="muted">正在加载...</view>
    <view wx:elif="{{error}}" class="muted">暂时无法读取招聘信息：{{error}} <text bindtap="loadLatest">点击重试</text></view>
    <view wx:elif="{{!latest.length}}" class="muted">暂无招聘信息</view>
    <view class="item" wx:for="{{latest}}" wx:key="id" data-index="{{index}}" bindtap="openDetail">
      <view class="item-title">{{item.title}}</view><view class="muted">{{item.subtitle}}</view>
    </view>
  </view>
  <view class="card" wx:if="{{othersLoading}}"><view class="muted">正在同步其他生活信息...</view></view>
  <view class="card" wx:for="{{otherSections}}" wx:for-item="section" wx:key="key">
    <view class="row"><view class="section-title">最新{{section.label}}</view><view class="muted" data-key="{{section.key}}" bindtap="openChannel">更多 ›</view></view>
    <view wx:if="{{section.error}}" class="muted">暂时无法读取：{{section.error}}</view>
    <view wx:elif="{{!section.items.length}}" class="muted">暂无信息</view>
    <view class="item" wx:for="{{section.items}}" wx:for-item="post" wx:for-index="postIndex" wx:key="id" data-key="{{section.key}}" data-index="{{postIndex}}" bindtap="openOtherDetail">
      <view class="item-title">{{post.title}}</view><view class="muted">{{post.subtitle}}</view>
    </view>
  </view>
  <view class="muted footer">信息来源：OpenAA 主站 · 使用前请核实发布内容</view>
</view>
