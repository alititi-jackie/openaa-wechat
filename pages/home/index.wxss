.hero{background:linear-gradient(135deg,#115eaa,#0b7892);color:#fff;border-radius:24rpx;padding:45rpx 32rpx;margin-bottom:22rpx}.hero-label{font-size:24rpx;opacity:.9}.hero-title{font-size:40rpx;font-weight:800;margin-top:18rpx;line-height:1.4}.hero-desc{font-size:26rpx;margin-top:16rpx;opacity:.92}.hero-pill{display:inline-block;padding:12rpx 20rpx;margin-top:26rpx;border-radius:40rpx;background:rgba(255,255,255,.18);font-size:24rpx}.overview{border:2rpx solid #d5e8ff}.overview-title{font-weight:700;font-size:32rpx;margin-bottom:10rpx}.feature-grid{display:flex;flex-wrap:wrap;justify-content:space-between;margin-bottom:24rpx}.feature{width:48.5%;box-sizing:border-box;min-height:188rpx;background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:18rpx}.feature-icon{font-size:43rpx;margin-bottom:14rpx}.feature-title{font-weight:700;font-size:29rpx;margin-bottom:9rpx}.disclaimer{font-size:23rpx;color:#667085;line-height:1.7}
