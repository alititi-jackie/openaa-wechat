<view class="container">
  <scroll-view scroll-x class="category-bar" enable-flex>
    <view class="pill {{active===item.key?'active':''}}" wx:for="{{channels}}" wx:key="key" data-key="{{item.key}}" bindtap="choose">{{item.label}}</view>
  </scroll-view>
  <view class="card filter-card">
    <view class="filter-row">
      <input class="filter-input" placeholder="搜索职位、房屋或服务关键词" value="{{draft.q}}" bindinput="changeKeyword" confirm-type="search" bindconfirm="applyFilters" />
      <button class="filter-button" size="mini" bindtap="applyFilters">搜索</button>
      <text class="filter-toggle" bindtap="toggleFilters">筛选{{filtersOpen?'收起':'展开'}}</text>
    </view>
    <view wx:if="{{filtersOpen}}" class="filter-extra">
      <input class="filter-input" placeholder="地区关键词，例如 Brooklyn" value="{{draft.area}}" bindinput="changeArea" />
      <view class="filter-row" wx:if="{{active!=='services'}}">
        <input class="filter-input" type="digit" placeholder="最低价格/薪资" value="{{draft.min}}" bindinput="changeMin" />
        <input class="filter-input" type="digit" placeholder="最高价格/薪资" value="{{draft.max}}" bindinput="changeMax" />
      </view>
      <picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="changeSort">
        <view class="sort-choice">排序：{{sortOptions[sortIndex]}} ▾</view>
      </picker>
      <view class="filter-row filter-actions">
        <button size="mini" bindtap="resetFilters">清空条件</button>
        <button type="primary" size="mini" bindtap="applyFilters">应用筛选</button>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="item" wx:for="{{items}}" wx:key="id" data-index="{{index}}" bindtap="openDetail">
      <view class="item-title">{{item.title}}</view><view class="muted">{{item.subtitle}}</view>
    </view>
    <view wx:if="{{loading}}" class="muted status">加载中...</view>
    <view wx:if="{{error}}" class="muted status">加载失败：{{error}} <text bindtap="load">点击重试</text></view>
    <view wx:if="{{!loading && !error && !items.length}}" class="muted status">暂无信息</view>
    <view wx:if="{{finished && items.length}}" class="muted status">已经到底了</view>
  </view>
  <view class="card">
    <view class="section-title">想发布信息？</view>
    <view class="muted">小程序只提供查看。前往 OpenAA.com 网页版登录后发布。</view>
    <button type="primary" style="margin-top:16rpx" bindtap="promptWebPublish">复制网页版发布网址</button>
  </view>
</view>
