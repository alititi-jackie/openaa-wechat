.study-head{margin:12rpx 0 22rpx}.progress{height:12rpx;background:#e4eaf1;border-radius:16rpx;margin-top:20rpx;overflow:hidden}.progress-fill{height:100%;background:#1565c0;border-radius:16rpx}.question-card{padding:30rpx}.question-number{color:#1565c0;font-size:24rpx;font-weight:700;margin-bottom:20rpx}.question-text{font-weight:700;font-size:34rpx;line-height:1.65;margin-bottom:22rpx}.sign-image{height:260rpx;width:100%;margin-bottom:25rpx}.choice{display:flex;align-items:center;border:2rpx solid #e1e6ee;border-radius:17rpx;padding:20rpx;margin:15rpx 0;line-height:1.5;min-height:66rpx}.choice-letter{height:50rpx;width:50rpx;line-height:50rpx;text-align:center;flex-shrink:0;border-radius:50%;background:#ecf2fa;color:#1356a0;font-weight:700;margin-right:18rpx}.choice-text{flex:1}.choice-correct{background:#e6f6eb;border-color:#56ac6e}.choice-wrong{background:#fff0ee;border-color:#e57e72}.answer{padding:20rpx;margin-top:24rpx;background:#eff6ff;border-radius:16rpx;line-height:1.7}.answer-title{font-size:29rpx;font-weight:700;margin-bottom:10rpx}.explanation{margin-top:12rpx;color:#465469}.next{margin-top:25rpx}.next[disabled]{opacity:.55}.small-print{text-align:center;margin:25rpx 0}.result{text-align:center;padding:65rpx 25rpx}.result-emoji{font-size:60rpx;margin-bottom:25rpx}.score{font-size:34rpx;color:#1565c0;font-weight:700;margin:30rpx 0}
